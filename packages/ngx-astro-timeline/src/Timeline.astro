---
interface TimelineEntry {
  title: string;
  content: string;
}

interface Props {
  entries: TimelineEntry[];
  orientation?: 'left' | 'right' | 'switch';
  entriesGap?: string;
  entryGap?: string;
  titleGap?: string;
  pathWidth?: string;
  titleMaxWidth?: string;
  pathColor?: string;
  gradientColors?: [string, string];
  class?: string;
}

const {
  entries,
  orientation = 'left',
  entriesGap = '5rem',
  entryGap = '4rem',
  titleGap = '2rem',
  pathWidth = '2px',
  titleMaxWidth = '25rem',
  pathColor = '#e2e8f0',
  gradientColors = ['#3b82f6', '#7f00ff'],
  class: className = '',
} = Astro.props;

const uid = Math.random().toString(36).slice(2, 10);
const gradientId = `tl-${uid}-gradient`;
const gradientBgId = `tl-${uid}-gradientBg`;

const style = [
  `--om-timeline-entries-gap: ${entriesGap}`,
  `--om-timeline-entry-gap: ${entryGap}`,
  `--om-timeline-entry-title-gap: ${titleGap}`,
  `--om-timeline-entry-title-max-width: ${titleMaxWidth}`,
  `--om-timeline-path-width: ${pathWidth}`,
  `--om-timeline-path-color: ${pathColor}`,
  `--om-timeline-gradient-start: ${gradientColors[0]}`,
  `--om-timeline-gradient-end: ${gradientColors[1]}`,
].join('; ');
---

<div
  class:list={['om-timeline', className, orientation]}
  data-om-timeline
  data-orientation={orientation}
  data-path-color={pathColor}
  data-gradient-colors={JSON.stringify(gradientColors)}
  style={style}
>
  <div class="om-timeline-entries">
    {
      entries.map((entry, index) => (
        <div
          class:list={[
            'om-timeline-entry',
            orientation === 'right' || (orientation === 'switch' && index % 2 !== 0)
              ? 'right-side'
              : 'left-side',
          ]}
          data-om-tl-entry
        >
          <div class="om-timeline-entry-header">
            <div class="om-timeline-circle">
              <div class="om-timeline-inner-circle"></div>
            </div>
            <div class="om-timeline-entry-title">{entry.title}</div>
          </div>
          <div class="om-timeline-entry-content" set:html={entry.content} />
        </div>
      ))
    }

    <div class="om-timeline-line-wrapper">
      <svg
        class:list={['om-timeline-svg', { 'd-none': orientation !== 'switch' }]}
        data-om-tl-svg
        xmlns="http://www.w3.org/2000/svg"
      >
        <defs>
          <linearGradient id={gradientId} x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" style="stop-color: transparent; stop-opacity: 1" />
            <stop offset="10%" style={`stop-color: ${gradientColors[1]}; stop-opacity: 1`} />
            <stop offset="90%" style={`stop-color: ${gradientColors[0]}; stop-opacity: 1`} />
            <stop offset="100%" style="stop-color: transparent; stop-opacity: 1" />
          </linearGradient>
          <linearGradient id={gradientBgId} x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" style="stop-color: transparent; stop-opacity: 1" />
            <stop offset="10%" style={`stop-color: ${pathColor}; stop-opacity: 1`} />
            <stop offset="90%" style={`stop-color: ${pathColor}; stop-opacity: 1`} />
            <stop offset="100%" style="stop-color: transparent; stop-opacity: 1" />
          </linearGradient>
        </defs>
        <path class="om-timeline-path" data-om-tl-path stroke={`url(#${gradientBgId})`}></path>
        <path class="om-timeline-gradient-path" data-om-tl-gradient-path stroke={`url(#${gradientId})`}></path>
      </svg>

      <div
        class:list={['om-timeline-line', { 'd-none': orientation === 'switch' }]}
        data-om-tl-bg
      >
        <div class="om-timeline-motion" data-om-tl-motion></div>
      </div>
    </div>
  </div>
</div>

<style>
  .om-timeline {
    --om-timeline-entries-gap: 5rem;
    --om-timeline-entry-gap: 4rem;
    --om-timeline-entry-title-gap: 2rem;
    --om-timeline-entry-title-max-width: 25rem;
    --om-timeline-path-width: 2px;

    --om-timeline-gradient-start: #3b82f6;
    --om-timeline-gradient-end: #7f00ff;
    --om-timeline-path-color: #e2e8f0;

    width: 100%;

    .om-timeline-entries {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: var(--om-timeline-entries-gap);
      padding: 10rem 0;

      .om-timeline-entry {
        display: flex;
        justify-content: start;
        padding-top: 20px;
        gap: var(--om-timeline-entry-gap);
      }
    }

    &.switch > .om-timeline-entries {
      gap: calc(var(--om-timeline-entries-gap) * 6);
    }

    .om-timeline-entry-header {
      position: sticky;
      top: 10rem;
      z-index: 40;
      display: flex;
      align-items: center;
      align-self: flex-start;
      gap: var(--om-timeline-entry-title-gap);
      width: 50%;
      max-width: var(--om-timeline-entry-title-max-width);

      .om-timeline-circle {
        height: 40px;
        width: 40px;
        border-radius: 50%;
        background-color: black;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }

      .om-timeline-inner-circle {
        height: 16px;
        width: 16px;
        border-radius: 50%;
        background-color: rgb(38 38 38);
        border: 1px solid rgb(64 64 64);
      }
    }

    .om-timeline-entry-content {
      flex: 1;
    }

    .om-timeline-line-wrapper {
      position: absolute;
      top: 0;
      left: 20px;
      pointer-events: none;

      .d-none {
        display: none;
        height: 0;
        width: 0;
      }

      .om-timeline-line {
        width: var(--om-timeline-path-width);
        background: linear-gradient(
          to bottom,
          transparent 0%,
          #e2e8f0 50%,
          transparent 100%
        );
        mask-image: linear-gradient(
          to bottom,
          transparent 0%,
          black 10%,
          black 90%,
          transparent 100%
        );
        overflow: hidden;
        position: absolute;
        top: 0;
        left: 0;
        width: 2px;
      }

      .om-timeline-motion {
        width: 2px;
        background: linear-gradient(
          to top,
          #7f00ff 0%,
          #3b82f6 50%,
          transparent 100%
        );
        border-radius: 50%;
      }
    }

    &.right {
      .om-timeline-entries .om-timeline-entry {
        flex-direction: row-reverse;

        .om-timeline-entry-header {
          flex-direction: row-reverse;
          justify-content: space-between;
        }
      }

      .om-timeline-line-wrapper {
        left: unset;
        right: 20px;
      }
    }

    &.switch {
      .om-timeline-entries .om-timeline-entry {
        &.right-side {
          flex-direction: row-reverse;

          .om-timeline-entry-header {
            flex-direction: row-reverse;
          }
        }

        &.left-side {
          flex-direction: row;

          .om-timeline-entry-header {
            flex-direction: row;
          }
        }
      }

      .om-timeline-line-wrapper {
        left: 20px;
      }
    }

    .om-timeline-path {
      stroke-width: var(--om-timeline-path-width);
      fill: none;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .om-timeline-gradient-path {
      stroke-width: var(--om-timeline-path-width);
      fill: none;
      stroke-linecap: round;
      stroke-linejoin: round;
      stroke-dasharray: 1000;
      stroke-dashoffset: 1000;
      transition: stroke-dashoffset 0.5s ease;
    }
  }

  @media only screen and (max-width: 1000px) {
    .om-timeline {
      &.switch > .om-timeline-entries {
        gap: calc(var(--om-timeline-entries-gap) * 3);
      }

      .om-timeline-entries {
        .om-timeline-entry {
          position: relative;
          flex-direction: column !important;

          .om-timeline-entry-header {
            position: relative;
            top: 0;
            max-width: 100%;
            text-align: left;
          }

          &.left-side {
            .om-timeline-entry-content {
              margin-left: 70px;
            }

            .om-timeline-entry-header {
              left: 0;
              margin-right: auto;
            }
          }

          &.right-side {
            .om-timeline-entry-header {
              right: 0;
              margin-left: auto;
              justify-content: space-between;
            }

            .om-timeline-entry-content {
              margin-right: 70px;
            }
          }
        }
      }
    }
  }
</style>

<script>
  (() => {
    const wrappers = document.querySelectorAll<HTMLElement>('[data-om-timeline]');
    if (!wrappers.length) return;

    wrappers.forEach((wrapper) => {
      const orientation = (wrapper.dataset.orientation ?? 'left') as 'left' | 'right' | 'switch';
      const entries = Array.from(wrapper.querySelectorAll<HTMLElement>('[data-om-tl-entry]'));
      const timelineBackground = wrapper.querySelector<HTMLElement>('[data-om-tl-bg]');
      const timelineLine = wrapper.querySelector<HTMLElement>('[data-om-tl-motion]');
      const timelineSvg = wrapper.querySelector<SVGSVGElement>('[data-om-tl-svg]');
      const timelinePath = wrapper.querySelector<SVGPathElement>('[data-om-tl-path]');
      const timelineGradientPath = wrapper.querySelector<SVGPathElement>('[data-om-tl-gradient-path]');

      let scrollableParent: HTMLElement | Window = window;
      let updatePending = false;

      function setHeight(): void {
        if (orientation !== 'switch') {
          const rect = wrapper.getBoundingClientRect();
          if (timelineBackground) timelineBackground.style.height = `${rect.height}px`;
        } else {
          updateSvgPath();
        }
        updateTimelineLine();
      }

      function updateTimelineLine(): void {
        if (updatePending) return;
        updatePending = true;

        requestAnimationFrame(() => {
          updatePending = false;

          const rect = wrapper.getBoundingClientRect();
          const scrollHeight =
            scrollableParent === window
              ? window.innerHeight
              : (scrollableParent as HTMLElement).clientHeight;

          const topPosition =
            scrollableParent === window
              ? rect.top * -1
              : (scrollableParent as HTMLElement).scrollTop;

          if (orientation === 'switch') {
            if (!timelineGradientPath) return;
            const availableScroll = Math.max(1, rect.height - scrollHeight);
            let progress = topPosition / availableScroll;
            if (progress >= 1) progress = 1;
            else if (progress <= 0) progress = 0;

            const length = timelineGradientPath.getTotalLength();
            timelineGradientPath.style.strokeDasharray = `${length}`;
            timelineGradientPath.style.strokeDashoffset = `${length * (1 - progress)}`;
            return;
          }

          if (!timelineLine) return;
          let progress = topPosition / rect.height;
          if (topPosition >= rect.height || progress >= 1) {
            timelineLine.style.height = `${rect.height}px`;
            return;
          }
          timelineLine.style.height = `${progress * rect.height + scrollHeight * 0.5}px`;
        });
      }

      function calculateSvgPath(): string {
        let path = '';
        const isMobile = window.innerWidth <= 1000;
        const curveExtension = isMobile ? 200 : 500;

        for (let i = 0; i < entries.length; i++) {
          const entryRect = entries[i].getBoundingClientRect();
          const wrapperRect = wrapper.getBoundingClientRect();
          const startX = i % 2 === 0 ? 0 : wrapperRect.width - 40;
          const endX = i % 2 === 0 ? wrapperRect.width - 40 : 0;
          const startY = entryRect.top - wrapperRect.top;
          const endY = entryRect.bottom - wrapperRect.top;

          if (i === 0) {
            path += `M${startX},${startY - 160}`;
          }

          const extendedY = endY + 10;
          path += ` L${startX},${extendedY}`;

          if (i < entries.length - 1) {
            const nextEntryRect = entries[i + 1].getBoundingClientRect();
            const nextStartY = nextEntryRect.top - wrapperRect.top;

            const controlPointY1 = extendedY + curveExtension;
            const controlPointY2 = nextStartY - curveExtension;

            path += ` C${startX},${controlPointY1} ${endX},${controlPointY2} ${endX},${nextStartY}`;
          } else {
            path += ` L${startX},${endY + 160}`;
          }
        }

        return path;
      }

      function updateSvgPath(): void {
        if (!timelineSvg || !timelinePath || !timelineGradientPath) return;
        const path = calculateSvgPath();
        const wrapperRect = wrapper.getBoundingClientRect();

        timelineSvg.setAttribute('width', `${wrapperRect.width - 20}`);
        timelineSvg.setAttribute('height', `${wrapperRect.height}`);
        timelinePath.setAttribute('d', path);
        timelineGradientPath.setAttribute('d', path);
      }

      function determineScrollContext(): void {
        let parent = wrapper.parentElement;
        while (parent && parent !== document.body) {
          const overflowY = window.getComputedStyle(parent).overflowY;
          if (overflowY === 'auto' || overflowY === 'scroll') {
            scrollableParent = parent;
            break;
          }
          parent = parent.parentElement;
        }
        setupScrollListener();
      }

      function setupScrollListener(): void {
        const target = scrollableParent === window ? window : scrollableParent;
        const listener = () => updateTimelineLine();
        target.addEventListener('scroll', listener, { passive: true });
      }

      queueMicrotask(() => setHeight());

      determineScrollContext();
      updateTimelineLine();

      window.addEventListener('resize', () => setHeight());

      const attrObserver = new MutationObserver(() => {
        const pathColor = wrapper.dataset.pathColor ?? '#e2e8f0';
        let gStart = '#3b82f6';
        let gEnd = '#7f00ff';
        try {
          const gc = JSON.parse(wrapper.dataset.gradientColors ?? '[]');
          if (Array.isArray(gc) && gc.length === 2) {
            gStart = gc[0];
            gEnd = gc[1];
          }
        } catch {
          /* ignore malformed gradient colors */
        }

        wrapper.style.setProperty('--om-timeline-path-color', pathColor);
        wrapper.style.setProperty('--om-timeline-gradient-start', gStart);
        wrapper.style.setProperty('--om-timeline-gradient-end', gEnd);

        const lgs = wrapper.querySelectorAll('[data-om-tl-svg] linearGradient');
        const grad = lgs[0];
        const gradBg = lgs[1];
        if (grad) {
          grad.children[1]?.setAttribute('style', `stop-color: ${gEnd}; stop-opacity: 1`);
          grad.children[2]?.setAttribute('style', `stop-color: ${gStart}; stop-opacity: 1`);
        }
        if (gradBg) {
          gradBg.children[1]?.setAttribute('style', `stop-color: ${pathColor}; stop-opacity: 1`);
          gradBg.children[2]?.setAttribute('style', `stop-color: ${pathColor}; stop-opacity: 1`);
        }
      });
      attrObserver.observe(wrapper, {
        attributes: true,
        attributeFilter: ['data-path-color', 'data-gradient-colors'],
      });
    });
  })();
</script>
